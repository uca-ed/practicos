    cola = []

    archivo = open(desde_archivo, "r")
    for linea  in archivo:
        linea = linea.strip()

        if linea.startswith("ENCOLAR"):
            _ , VALOR = linea.split()
            cola.append(VALOR)

        elif linea == "DESENCOLAR":
            if len(cola) > 0:
                cola.pop(0)

    archivo.close()
    print("Estado final de la cola:", cola)


