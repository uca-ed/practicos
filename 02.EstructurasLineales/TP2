def crear_celda(valor):
    return {"valor": valor, "siguiente": None}

def agregar_a_lista_enlazada(lista, val):
    nueva_celda = crear_celda(val)

    if not lista["cabeza"]:
        lista["cabeza"] = nueva_celda
    else:
        actual = lista["cabeza"]
        while actual["siguiente"] :
            actual = actual["siguiente"]
        actual["siguiente"] = nueva_celda

def imprimir_lista_enlazada(lista):
    actual = lista["cabeza"]
    elementos = []
    while actual:
        elementos.append(actual["valor"])
        actual = actual["siguiente"]
    print(" -> ".join(map(str, elementos)) )


