import random



EDIFICIOS = 4
PISOS = 5
ALAS = 2
AULAS = 25
BLOQUES = 17
TOTAL = EDIFICIOS * PISOS * ALAS * AULAS * BLOQUES


INSCRIPTOS=[0]*TOTAL
CAPACIDAD= [0] *TOTAL

def obtener_indice(edificio, piso, ala, aula, bloque):
    return (
        edificio * PISOS * ALAS * AULAS * BLOQUES +
        piso * ALAS * AULAS * BLOQUES +
        ala * AULAS * BLOQUES +
        aula * BLOQUES +
        bloque)

def cargar_datos_simples():
    for e in range(EDIFICIOS):
        for p in range(PISOS):
            for a in range(ALAS):
                for u in range(AULAS):
                    for b in range(BLOQUES):
                        idx = obtener_indice(e, p, a, u, b)
                        CAPACIDAD[idx] = random.randint(30, 60)
                        INSCRIPTOS[idx] = random.randint(0, CAPACIDAD[idx])

def aula_con_mayor_ocupacion_simple():
    max_porcentaje = -1
    e_max = 0
    p_max = 0
    a_max = 0
    u_max = 0
    b_max = 0

    for i in range(TOTAL):
        if CAPACIDAD[i] == 0:
            continue
        porcentaje = INSCRIPTOS[i] / CAPACIDAD[i]
        if porcentaje > max_porcentaje:
            max_porcentaje = porcentaje
            temp = i
            b_max = temp % BLOQUES
            temp //= BLOQUES
            u_max = temp % AULAS
            temp //= AULAS
            a_max = temp % ALAS
            temp //= ALAS
            p_max = temp % PISOS
            temp //= PISOS
            e_max = temp

    print("Aula con mas ocupacion:")
    print("Edificio:", e_max, "Piso:", p_max, "Ala:", "Norte" if a_max == 0 else "Sur", "Aula:", u_max, "Bloque:", b_max)
    print("Porcentaje:", round(max_porcentaje * 100, 2), "%")

def promedio_alumnos_por_piso(bloque_param):
    for p in range(PISOS):
        total_alumnos_piso = 0
        total_aulas_piso = 0
        for e in range(EDIFICIOS):
            for a in range(ALAS):
                for u in range(AULAS):
                    idx = obtener_indice(e, p, a, u, bloque_param)
                    total_alumnos_piso += INSCRIPTOS[idx]
                    total_aulas_piso += 1

        if total_aulas_piso > 0:
            promedio = total_alumnos_piso / total_aulas_piso
            print(f"Piso {p}: promedio {promedio:.2f} alumnos")
        else:
            print(f"Piso {p}: No hay aulas")

