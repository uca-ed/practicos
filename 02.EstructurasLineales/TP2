from collections import defaultdict, deque

def leer_grafo_desde_archivo(nombre_archivo):
    grafo = defaultdict(list)
    nodos = set()

    with open(nombre_archivo, 'r') as f:
        for linea in f:
            if linea.strip() == '':
                continue
            partes = linea.strip().split()
            origen = partes[0]
            if len(partes) > 1:
                destino = partes[1]
                grafo[origen].append(destino)
                nodos.add(destino)
            nodos.add(origen)

    for nodo in nodos:
        if nodo not in grafo:
            grafo[nodo] = []
    return grafo

def sort_topologico(grafo):
    grado_entrada = defaultdict(int)

    for nodo in grafo:
        for vecino in grafo[nodo]:
            grado_entrada[vecino] += 1
    cola = deque([n for n in grafo if grado_entrada[n] == 0])
    orden = []

    while cola:
        actual = cola.popleft()
        orden.append(actual)
        for vecino in grafo[actual]:
            grado_entrada[vecino] -= 1
            if grado_entrada[vecino] == 0:
                cola.append(vecino)

    if len(orden) !=len(grafo):
        print("Error: el grafo tiene un ciclo. no se puede ordenar topologicamente.")
        return None
    else:
        print("Orden topologico:", orden)
        return orden



