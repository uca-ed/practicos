from collections import defaultdict, deque

def t_sort(grafo):

    grados_entrantes = defaultdict(int)
    for nodo in grafo:
        for prox_nodo in grafo[nodo]:
            grados_entrantes[prox_nodo] += 1

    cola = deque([n for n in grafo if grados_entrantes[n] == 0])

    orden = []

    while cola:
        nodo_actual = cola.popleft()
        orden.append(nodo_actual)

        for prox_nodo in grafo[nodo_actual]:
            grados_entrantes[prox_nodo] -= 1
            if grados_entrantes[prox_nodo] == 0 :
                cola.append(prox_nodo)

    if len(orden) != len(grafo):
        print("Error: el grafo contiene un ciclo. no se puede hacer T-Sort.")
    else:
        print("Orden topologico:", orden, )





