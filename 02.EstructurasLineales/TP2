def counting_sort_por_letra(las_palabras, pos_actual):
    N = len(las_palabras)
    salida_temp = ["" for _ in range(N)]
    conteo = [0] * 256

    for una_palabra in las_palabras:
        letra_char = ord(una_palabra[pos_actual]) if pos_actual < len(una_palabra) else 0
        conteo[letra_char] += 1

    for indice in range(1, 256):
        conteo[indice] += conteo[indice - 1]

    for palabra_rev in reversed(las_palabras):
        letra_del_momento = ord(palabra_rev[pos_actual]) if pos_actual < len(palabra_rev) else 0
        salida_temp[conteo[letra_del_momento] - 1] = palabra_rev
        conteo[letra_del_momento] -= 1

    return salida_temp

def radix_sort_palabras(mis_palabras):
    if not mis_palabras:
        return []

    max_longitud = max(len(p) for p in mis_palabras)

    for p_idx in reversed(range(max_longitud)):
        mis_palabras = counting_sort_por_letra(mis_palabras, p_idx)

    return mis_palabras


