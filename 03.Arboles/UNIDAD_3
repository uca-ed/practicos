
"""PRACTICA 3

Árboles
Dado un arreglo sobre el que está representado un árbol de grado indicado como dato, dar un algoritmo que: a) detecte la altura del árbol sin hacer recorridos
"""

import math

def calcular_altura_arbol(cant_nodos, grado):
    if grado == 1:
        return cant_nodos
    altura = math.floor(math.log((cant_nodos * (grado - 1)) + 1, grado))
    return altura

"""b) realice un barrido pre-orden"""

