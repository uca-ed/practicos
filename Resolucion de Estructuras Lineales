def mayor_ocupacion():
    max_porcentaje = 0
    mejor_pos = None
    for i in range(len(INSCRIPTOS)):
        if CAPACIDAD[i] == 0:
            continue
        porcentaje = INSCRIPTOS[i] / CAPACIDAD[i]
        if porcentaje > max_porcentaje:
            max_porcentaje = porcentaje
            mejor_pos = i
    return mejor_pos, max_porcentaje
