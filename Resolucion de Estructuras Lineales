def procesar_cola(nombre_archivo):
    cola = []
    with open(nombre_archivo, 'r') as archivo:
        for linea in archivo:
            partes = linea.strip().split()
            operacion = partes[0]
            if operacion == "ENQUEUE":
                elemento = partes[1]
                cola.append(elemento)
            elif operacion == "DEQUEUE":
                if cola:
                    cola.pop(0)
    print("Cola final:", cola)

