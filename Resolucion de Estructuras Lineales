def counting_sort(palabras, index):
    buckets = [[] for _ in range(27)]
    for palabra in palabras:
        letra = ord(palabra[index]) - ord('a') + 1 if index < len(palabra) else 0
        buckets[letra].append(palabra)
    return [palabra for bucket in buckets for palabra in bucket]

def radix_sort(palabras):
    max_len = max(len(palabra) for palabra in palabras)
    for i in range(max_len - 1, -1, -1):
        palabras = counting_sort(palabras, i)
    return palabras

