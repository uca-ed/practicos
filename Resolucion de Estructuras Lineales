def procesar_operaciones_pila(nombre_archivo):
    pila = []
    with open(nombre_archivo, 'r') as archivo:
        for linea in archivo:
            op = linea.strip().split()
            if op[0] == "PUSH":
                pila.append(op[1])
            elif op[0] == "POP" and pila:
                pila.pop()
    print("Pila final:", pila)

EJERCICIO 3 

class Nodo:
    def __init__(self, valor):
        self.valor = valor
        self.siguiente = None

class ListaSimple:
    def __init__(self):
        self.cabeza = None

    def insertar(self, valor):
        nuevo = Nodo(valor)
        nuevo.siguiente = self.cabeza
        self.cabeza = nuevo

    def mostrar(self):
        actual = self.cabeza
        while actual:
            print(actual.valor, end=" -> ")
            actual = actual.siguiente
        print("None")

