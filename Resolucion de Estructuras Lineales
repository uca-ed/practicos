def procesar_operaciones_pila(nombre_archivo):
    pila = []
    with open(nombre_archivo, 'r') as archivo:
        for linea in archivo:
            op = linea.strip().split()
            if op[0] == "PUSH":
                pila.append(op[1])
            elif op[0] == "POP" and pila:
                pila.pop()
    print("Pila final:", pila)

