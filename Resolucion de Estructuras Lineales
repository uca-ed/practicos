dimensiones = [4, 5, 2, 25, 17]
total_size = 1
for d in dimensiones:
    total_size *= d

INSCRIPTOS = [0] * total_size
CAPACIDAD = [1] * total_size  # valores de ejemplo

def obtener_posicion(d0, d1, d2, d3, d4):
    return (d0 * 5 * 2 * 25 * 17 +
            d1 * 2 * 25 * 17 +
            d2 * 25 * 17 +
            d3 * 17 +
            d4)

