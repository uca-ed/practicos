def minimales(matriz):
   
    n = len(matriz)
    res = []
    for col in range(n):
        columna = [matriz[fila][col] for fila in range(n)]
        if sum(columna) == 0:
            res.append(col)
    return res


def maximales(matriz):
   
    n = len(matriz)
    res = []
    for fila in range(n):
        if sum(matriz[fila]) == 0:
            res.append(fila)
    return res


def vecindad_derecha(matriz, nodo):
   
    return [j for j, val in enumerate(matriz[nodo]) if val == 1]


def vecindad_izquierda(matriz, nodo):
   
    return [i for i in range(len(matriz)) if matriz[i][nodo] == 1]



def imprimir_matriz(matriz):
    for fila in matriz:
        print(" ".join(map(str, fila)))
