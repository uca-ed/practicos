def cargar_grafo(ruta_archivo):
    with open(ruta_archivo, 'r') as f:
        return json.load(f)['E']


def paso(grafo, inicio, fin):
    cola = [[inicio]]
    visitados = set()

    while cola:
        camino = cola.pop(0)
        nodo = camino[-1]

        if nodo == fin:
            return camino

        if nodo not in visitados:
            visitados.add(nodo)
            for vecino in grafo.get(nodo, []):
                cola.append(camino + [vecino])

    return []
